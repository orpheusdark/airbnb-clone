MONGODB_URI=mongodb://127.0.0.1:27017/airbnb_clone?replicaSet=rs0
PORT=3000
# Generate a unique random value of at least 32 characters; do not commit it.
SESSION_SECRET=
APP_URL=http://localhost:3000
NODE_ENV=development
# Set TRUST_PROXY=1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional: Gmail SMTP for password recovery and account/reservation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Application queue cap per rolling 24 hours; Gmail limits still apply.
MAIL_DAILY_LIMIT=300
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
