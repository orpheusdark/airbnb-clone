MONGODB_URI=mongodb://127.0.0.1:27017/airbnb_clone?replicaSet=rs0
PORT=3000
# Generate a unique random value of at least 32 characters; do not commit it.
SESSION_SECRET=
APP_URL=http://localhost:3000
NODE_ENV=development
# Set TRUST_PROXY=1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional: password recovery requires an SMTP mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
