<dialog id="dates-dialog" class="app-dialog dates-dialog" aria-labelledby="dates-title"><div class="dialog-heading"><button type="button" class="icon-button" data-close-dialog aria-label="Close date picker"><%- include('icon', { name: 'close', size: 20 }) %></button><h2 id="dates-title">Select your dates</h2></div><div class="dialog-content"><p class="calendar-instruction" data-calendar-instruction>Choose a check-in date, then a check-out date.</p><div class="calendar-navigation"><button type="button" class="icon-button" data-calendar-month="-1" aria-label="Previous month"><%- include('icon', { name: 'left', size: 17 }) %></button><button type="button" class="icon-button" data-calendar-month="1" aria-label="Next month"><%- include('icon', { name: 'right', size: 17 }) %></button></div><div class="calendar-months" data-calendar-months></div><p class="calendar-selection" data-calendar-selection aria-live="polite"></p></div><div class="dialog-footer"><button type="button" class="text-button" data-clear-dates>Clear dates</button><button type="button" class="button button-dark" data-apply-dates>Apply dates</button></div></dialog>
