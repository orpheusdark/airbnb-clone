<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= listing.title %> | airbnb</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include("partials/navbar.ejs") %>

    <main class="detail-page">
      <% if (notice) { %><p class="success-notice" role="status"><%= notice %></p><% } %>
      <a class="back-link" href="/listings">← Back to all stays</a>

      <header class="detail-heading">
        <div>
          <p class="eyebrow">YOUR NEXT STAY</p>
          <h1><%= listing.title %></h1>
          <p class="detail-location">
            <span aria-hidden="true">⌖</span>
            <%= listing.location %>, <%= listing.country %>
          </p>
        </div>
        <p class="detail-price">
          ₹<%= Number(listing.price).toLocaleString("en-IN") %>
          <span>/ night</span>
        </p>
      </header>

      <div class="listing-actions"><a class="create-listing-btn" href="/listings/<%= listing._id %>/edit">Edit property</a><a class="delete-link" href="/listings/<%= listing._id %>/delete">Delete property</a></div>
      <section class="detail-gallery">
        <img
          src="<%= listing.image || 'https://placehold.co/1200x800?text=airbnb' %>"
          alt="<%= listing.title %>"
        />
        <span class="gallery-label">PROPERTY GALLERY</span>
      </section>

      <section class="detail-content">
        <article class="detail-description">
          <p class="eyebrow">THE PROPERTY</p>
          <h2>Make yourself at home.</h2>
          <p><%= listing.description %></p>

          <div class="detail-divider"></div>

          <h3>Location</h3>
          <p><%= listing.location %>, <%= listing.country %></p>
        </article>

        <aside class="booking-card">
          <p class="booking-price">
            ₹<%= Number(listing.price).toLocaleString("en-IN") %>
            <span>/ night</span>
          </p>

          <div class="booking-note">
            <span class="booking-dot"></span>
            <span>Ready for your next getaway</span>
          </div>

          <button
            class="booking-btn"
            type="button"
            disabled
            title="Booking functionality is coming later"
          >
            Booking coming soon
          </button>

          <p class="booking-disclaimer">
            This is a project demo. No reservation or payment is processed.
          </p>
        </aside>
      </section>
    </main>
  </body>
</html>
