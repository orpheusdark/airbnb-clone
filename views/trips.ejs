<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'My trips' }) %><body><%- include('partials/navbar') %><main class="listings-page"><p class="eyebrow">PLACES, PEOPLE, MEMORIES</p><h1>My trips</h1>
<% if (!bookings.length) { %><section class="empty-state"><h2>Your next journey starts here</h2><p>Your reservations will appear here.</p><a href="/listings">Find a stay</a></section><% } %>
<div class="trip-grid"><% bookings.forEach(booking => { %><article class="trip-card"><span class="status-badge"><%= booking.status %></span><h2><a href="/trips/<%= booking._id %>"><%= booking.title %></a></h2><p><%= booking.location %></p><p><%= date(booking.checkIn) %> → <%= date(booking.checkOut) %></p><p><%= booking.guests %> guest(s) · <%= booking.nights %> night(s)</p><strong><%= money(booking.totalPaise) %></strong><p>Payment: <%= booking.payment === 'test-paid' ? 'Test payment confirmed' : booking.payment === 'test-refunded' ? 'Test payment reversed' : booking.payment === 'refund-pending' ? 'Reversal pending' : 'Not collected' %></p><a href="/trips/<%= booking._id %>">View reservation</a></article><% }) %></div>
</main><%- include('partials/footer') %></body></html>
