<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'My trips' }) %><body><%- include('partials/navbar') %><main class="page-shell trips-page" id="main-content"><header class="page-heading"><div><h1>Trips</h1><p>Your next adventure, and the memories you’ve made.</p></div><a class="button button-outline" href="/listings">Find a stay<%- include('partials/icon', { name: 'arrow', size: 18 }) %></a></header><div class="page-tabs" role="tablist" aria-label="Filter trips"><button class="active" role="tab" aria-selected="true" data-trip-filter="all">All trips</button><button role="tab" aria-selected="false" data-trip-filter="upcoming">Upcoming</button><button role="tab" aria-selected="false" data-trip-filter="past">Past</button><button role="tab" aria-selected="false" data-trip-filter="cancelled">Cancelled</button></div><% if (!bookings.length) { %><section class="empty-state trip-empty"><span class="empty-icon"><%- include('partials/icon', { name: 'luggage', size: 40 }) %></span><h2>No trips booked… yet!</h2><p>Time to dust off your bags and start planning your next adventure.</p><a class="button button-primary" href="/listings">Start searching</a></section><% } %><div class="trip-grid"><% bookings.forEach(booking => { const group = booking.status === 'cancelled' ? 'cancelled' : date(booking.checkOut) > today ? 'upcoming' : 'past'; %><article class="trip-card" data-trip-group="<%= group %>"><a href="/trips/<%= booking._id %>" class="trip-photo"><img src="<%= photoFor(booking.listing || {}) %>" alt="<%= booking.title %>" loading="lazy"><span class="status-badge status-<%= booking.status %>"><%= booking.status %></span></a><div class="trip-card-body"><p class="eyebrow"><%= group === 'upcoming' ? 'YOUR NEXT GETAWAY' : group === 'past' ? 'A PLACE YOU’VE BEEN' : 'CANCELLED TRIP' %></p><h2><a href="/trips/<%= booking._id %>"><%= booking.title %></a></h2><p class="muted"><%= booking.location %></p><div class="trip-dates"><%- include('partials/icon', { name: 'calendar', size: 18 }) %><span><%= date(booking.checkIn) %> — <%= date(booking.checkOut) %></span></div><div class="trip-card-bottom"><span><%= booking.guests %> guests · <%= booking.nights %> nights</span><strong><%= money(booking.totalPaise) %></strong></div><a href="/trips/<%= booking._id %>" class="text-link">View reservation<%- include('partials/icon', { name: 'right', size: 16 }) %></a></div></article><% }) %></div><div class="empty-state" data-trip-empty hidden><span class="empty-icon"><%- include('partials/icon', { name: 'luggage', size: 36 }) %></span><h2>No trips here yet</h2><p>Try another tab or start planning your next stay.</p><a href="/listings" class="button button-outline">Explore homes</a></div></main><%- include('partials/footer') %></body></html>
