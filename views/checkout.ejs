<% const changeUrl = '/listings/' + listing._id + '?checkIn=' + date(stay.checkIn) + '&checkOut=' + date(stay.checkOut) + '&guests=' + stay.guests + '#reserve'; %>
<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'Review your reservation' }) %><body class="checkout-page"><%- include('partials/navbar') %>
<main class="checkout-shell" id="main-content"><a href="/listings/<%= listing._id %>" class="back-link"><%- include('partials/icon', { name: 'left', size: 18 }) %>Back to property</a><h1>Review your reservation</h1><div class="checkout-layout"><div class="checkout-main"><section class="checkout-section"><h2>Your trip</h2><div class="trip-detail-row"><div><h3>Dates</h3><p><%= date(stay.checkIn) %> — <%= date(stay.checkOut) %></p></div><a href="<%= changeUrl %>" class="text-link">Edit</a></div><div class="trip-detail-row"><div><h3>Guests</h3><p><%= stay.guests %> guest<%= stay.guests === 1 ? '' : 's' %></p></div><a href="<%= changeUrl %>" class="text-link">Edit</a></div></section><section class="checkout-section"><h2>Cancellation policy</h2><p><strong>Cancel before your check-in date.</strong> Manage your reservation from My trips. Once your stay begins, cancellation is no longer available.</p><a href="/help#reservations" class="text-link">Learn more</a></section><section class="checkout-section"><div class="section-heading"><h2><%= paymentEnabled && stay.totalPaise > 0 ? 'Payment' : 'Confirm your stay' %></h2><%- include('partials/icon', { name: 'card', size: 26 }) %></div><p><%= paymentEnabled && stay.totalPaise > 0 ? 'Continue to secure checkout to complete your reservation.' : 'No payment is collected when you confirm this reservation.' %></p><form method="POST" action="<%= paymentEnabled && stay.totalPaise > 0 ? '/payments/order' : '/bookings' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="key" value="<%= key %>"><button class="button button-primary checkout-confirm"><%= paymentEnabled && stay.totalPaise > 0 ? 'Continue to payment' : 'Confirm reservation' %><%- include('partials/icon', { name: 'arrow', size: 18 }) %></button></form><p class="secure-note"><%- include('partials/icon', { name: 'lock', size: 14 }) %>Your dates are reserved after confirmation.</p></section></div><aside class="checkout-price-card"><div class="checkout-property"><img src="<%= photoFor(listing) %>" alt="<%= listing.title %>"><div><p class="muted small"><%= listing.category || 'Home' %> · <%= listing.location %></p><h2><%= listing.title %></h2><p class="small"><%= listing.country %></p></div></div><div class="price-card-content"><h2>Price details</h2><dl class="summary-list"><dt><%= money(stay.nightlyPaise) %> × <%= stay.nights %> night<%= stay.nights === 1 ? '' : 's' %></dt><dd><%= money(stay.totalPaise) %></dd><dt class="summary-total">Total (INR)</dt><dd class="summary-total"><%= money(stay.totalPaise) %></dd></dl><p class="muted small">The total includes the nightly accommodation price.</p></div></aside></div></main><%- include('partials/footer') %></body></html>
