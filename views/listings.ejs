
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore Stays | Airbnb</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include("partials/navbar.ejs") %>

  <main class="listings-page">
      <% if (notice) { %><p class="success-notice" role="status"><%= notice %></p><% } %>
    <section class="listings-heading">
      <div>
        <p class="eyebrow">YOUR NEXT GETAWAY</p>
        <h1><% if (savedPage) { %>Your saved stays.<% } else { %>Find a place to <span>belong.</span><% } %></h1>
        <p class="page-description">
          Discover places worth travelling for.
        </p>
      </div>

      <a href="/listings/new" class="create-listing-btn">
        + Add a property
      </a>
    </section>

    <% if (!savedPage) { %><nav class="category-nav" aria-label="Stay categories"><a href="/listings" class="<%= !filters.category ? 'selected' : '' %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 11 12 3l9 8M5 9v12h14V9M9 21v-7h6v7"/></svg>All stays</a><% categories.forEach(category => { %><a href="/listings?category=<%= encodeURIComponent(category) %>" class="<%= filters.category === category ? 'selected' : '' %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="<%= { Home: 'M3 11 12 3l9 8M5 9v12h14V9M9 21v-7h6v7', Apartment: 'M5 21V3h14v18M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1M10 21v-3h4v3', Cabin: 'M2 12 12 2l10 10M5 10v11h14V10M9 21v-7h6v7M17 7V3h3v7', Villa: 'M2 12 8 5l6 7M4 10v11h9V10M14 21V9h6v12M16 13h2m-2 4h2M8 21v-5', Hotel: 'M3 21V4h18v17M7 8h2m6 0h2M7 12h2m6 0h2M9 21v-5h6v5' }[category] %>"/></svg><%= category %>s</a><% }) %></nav>
    <form method="GET" action="/listings" class="search-panel" aria-label="Search properties">
      <div class="search-primary-grid">
        <div class="form-field"><label for="q">Where</label><input id="q" name="q" placeholder="Search destinations" value="<%= filters.q || '' %>" maxlength="100"></div>
        <div class="form-field"><label for="checkIn">Check-in</label><input id="checkIn" name="checkIn" type="date" min="<%= today %>" value="<%= filters.checkIn || '' %>"></div>
        <div class="form-field"><label for="checkOut">Check-out</label><input id="checkOut" name="checkOut" type="date" min="<%= today %>" value="<%= filters.checkOut || '' %>"></div>
        <div class="form-field"><label for="guests">Guests</label><input id="guests" name="guests" type="number" placeholder="Add guests" min="1" max="30" value="<%= filters.guests || '' %>"></div>
        <button class="create-listing-btn search-submit">Search</button>
      </div>
      <details class="advanced-filters" <%= filters.category || filters.minPrice || filters.maxPrice || (filters.sort && filters.sort !== 'newest') ? 'open' : '' %>>
        <summary>Filters and sorting</summary>
        <div class="filter-grid">
          <div class="form-field"><label for="category">Property type</label><select id="category" name="category"><option value="">Any type</option><% categories.forEach(category => { %><option <%= filters.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div>
          <div class="form-field"><label for="minPrice">Min price (₹)</label><input id="minPrice" name="minPrice" type="number" min="0" max="100000000" step="0.01" value="<%= filters.minPrice || '' %>"></div>
          <div class="form-field"><label for="maxPrice">Max price (₹)</label><input id="maxPrice" name="maxPrice" type="number" min="0" max="100000000" step="0.01" value="<%= filters.maxPrice || '' %>"></div>
          <div class="form-field"><label for="sort">Sort by</label><select id="sort" name="sort"><option value="newest">Newest first</option><option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option><option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option></select></div>
        </div>
      </details>
      <% if (Object.values(filters).some(value => value)) { %><a class="clear-filters" href="/listings">Clear all filters</a><% } %>
    </form>
    <% } %><p class="results-count"><%= total %> <%= savedPage ? 'saved properties' : 'stays found' %></p>
    <% if (listings.length === 0) { %>
      <section class="empty-state">
        <h2><%= savedPage ? "No saved stays yet" : "No stays match your search" %></h2>
        <p><%= savedPage ? "Save properties from their details page to find them here." : "Try changing your filters or add a property." %></p>
        <a href="/listings/new">Create your first listing</a>
      </section>
    <% } else { %>
      <section class="listing-grid">
        <% listings.forEach((listing) => { %>
          <article class="listing-card">
            <a
              class="listing-image-link"
              href="/listings/<%= listing._id %>"
              aria-label="View <%= listing.title %>"
            >
              <img
                class="listing-image"
                src="<%= photoFor(listing) %>"
                alt="<%= listing.title %>"
                loading="lazy"
              >
              <span class="image-label"><%= listing.category || 'Home' %></span>
            </a>

            <div class="listing-info">
              <div class="listing-location">
                <span><%= listing.location %>, <%= listing.country %></span>
                <span class="location-dot">●</span>
              </div>

              <h2><%= listing.title %></h2>

              <p class="listing-description">
                <%= listing.description %>
              </p>

              <div class="listing-card-bottom">
                <p class="listing-price">
                  ₹<%= Number(listing.price).toLocaleString("en-IN") %>
                  <span>/ night</span>
                </p>

                <a
                  class="details-link"
                  href="/listings/<%= listing._id %>"
                >
                  Explore <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        <% }); %>
      </section>
    <% } %>
    <% if (pages > 1) { %><nav class="pagination" aria-label="Results pages"><% if (page > 1) { %><a href="<%= paginationUrl(page - 1) %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a href="<%= paginationUrl(page + 1) %>">Next →</a><% } %></nav><% } %>
  </main>
<%- include('partials/footer') %></body>
</html>
