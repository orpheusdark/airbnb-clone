<!DOCTYPE html>
<html lang="en"><%- include('partials/head', { title: savedPage ? 'Wishlists' : 'Vacation rentals & unique homes' }) %><body class="<%= savedPage ? 'saved-page' : 'discovery-page' %>">
<%- include('partials/navbar') %>
<% if (!savedPage) { %>
<section class="search-section" aria-label="Find a stay">
  <form method="GET" action="/listings" id="stay-search" class="stay-search" data-search-form>
    <div class="search-pill">
      <div class="search-segment search-destination"><label for="q">Where</label><input id="q" name="q" placeholder="Search destinations" value="<%= filters.q || '' %>" maxlength="100" autocomplete="off" list="destinations"><datalist id="destinations"><option value="Goa"><option value="Manali"><option value="Mumbai"><option value="Jaipur"><option value="Ooty"><option value="Udaipur"></datalist></div>
      <div class="search-segment"><label for="checkIn">Check-in</label><input id="checkIn" name="checkIn" type="date" min="<%= today %>" value="<%= filters.checkIn || '' %>" data-check-in></div>
      <div class="search-segment"><label for="checkOut">Check-out</label><input id="checkOut" name="checkOut" type="date" min="<%= today %>" value="<%= filters.checkOut || '' %>" data-check-out></div>
      <details class="guest-picker" data-menu><summary role="button" aria-expanded="false"><span class="segment-label">Who</span> <span data-guest-summary><%= filters.guests ? filters.guests + ' guests' : 'Add guests' %></span></summary><div class="guest-popover"><div><strong>Guests</strong><p>Number of people staying</p></div><div class="stepper-control"><button type="button" data-step="-1" data-step-target="guests" aria-label="Remove a guest"><%- include('partials/icon', { name: 'minus', size: 16 }) %></button><label class="sr-only" for="guests">Guests</label><input id="guests" name="guests" type="number" min="1" max="30" value="<%= filters.guests || '' %>" placeholder="0" data-guest-input><button type="button" data-step="1" data-step-target="guests" aria-label="Add a guest"><%- include('partials/icon', { name: 'plus', size: 16 }) %></button></div></div></details>
      <button class="search-submit" aria-label="Search stays"><%- include('partials/icon', { name: 'search', size: 19 }) %><span>Search</span></button>
    </div>
    <dialog id="filters-dialog" class="app-dialog filters-dialog" aria-labelledby="filters-title"><div class="dialog-heading"><button type="button" class="icon-button" data-close-dialog aria-label="Close filters"><%- include('partials/icon', { name: 'close', size: 20 }) %></button><h2 id="filters-title">Filters</h2></div><div class="dialog-content">
      <section class="filter-section"><h3>Type of place</h3><p>Find a space that feels like you.</p><div class="type-options"><label><input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %>><span><%- include('partials/icon', { name: 'home' }) %>Any type</span></label><% categories.forEach(category => { %><label><input type="radio" name="category" value="<%= category %>" <%= filters.category === category ? 'checked' : '' %>><span><%- include('partials/icon', { name: category === 'Apartment' || category === 'Hotel' ? 'building' : category === 'Cabin' ? 'cabin' : 'home' }) %><%= category %></span></label><% }) %></div></section>
      <section class="filter-section"><h3>Price range</h3><p>Nightly prices in Indian rupees.</p><div class="form-row"><div class="form-field"><label for="minPrice">Minimum price (₹)</label><input id="minPrice" name="minPrice" type="number" min="0" max="100000000" step="0.01" placeholder="No minimum" value="<%= filters.minPrice || '' %>"></div><div class="form-field"><label for="maxPrice">Maximum price (₹)</label><input id="maxPrice" name="maxPrice" type="number" min="0" max="100000000" step="0.01" placeholder="No maximum" value="<%= filters.maxPrice || '' %>"></div></div></section>
      <section class="filter-section"><h3>Sort your stays</h3><div class="form-field"><label class="sr-only" for="sort">Sort by</label><select id="sort" name="sort"><option value="newest">Newest first</option><option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option><option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option></select></div></section>
    </div><div class="dialog-footer"><button class="text-button" type="button" data-clear-filters>Clear filters</button><button class="button button-dark" type="submit">Show stays</button></div></dialog>
  </form>
</section>
<% } %>
<main class="listings-page page-shell" id="main-content" data-saved-page="<%= savedPage %>">
  <%- include('partials/notice') %>
  <% if (savedPage) { %><header class="page-heading"><div><p class="eyebrow">YOUR COLLECTION</p><h1>Wishlists</h1><p>Keep the places you love in one place.</p></div></header>
  <% } else { %>
  <div class="discovery-toolbar"><nav class="category-nav" aria-label="Stay categories"><a href="/listings" class="<%= !filters.category ? 'selected' : '' %>" <%- !filters.category ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: 'grid' }) %><span>All homes</span></a><% categories.forEach(category => { %><a href="<%= categoryUrl(category) %>" class="<%= filters.category === category ? 'selected' : '' %>" <%- filters.category === category ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: category === 'Cabin' ? 'cabin' : category === 'Apartment' || category === 'Hotel' ? 'building' : 'home' }) %><span><%= category %>s</span></a><% }) %></nav><button class="filter-button" type="button" data-open-dialog="filters-dialog"><%- include('partials/icon', { name: 'filters', size: 18 }) %>Filters<% const count = ['category','minPrice','maxPrice'].filter(key => filters[key]).length; if (count) { %><span class="filter-count"><%= count %></span><% } %></button></div>
  <% } %>
  <div class="results-heading"><h1 class="<%= savedPage ? 'sr-only' : '' %>"><%= savedPage ? 'Your saved properties' : filters.q ? 'Stays in ' + filters.q : filters.category ? categories.includes(filters.category) ? filters.category + 's for your next getaway' : 'Find your next stay' : 'Homes for your next getaway' %></h1><div class="results-meta"><p class="results-count"><%= total %> <%= savedPage ? (total === 1 ? 'saved property' : 'saved properties') : (total === 1 ? 'stay found' : 'stays found') %></p><% if (!savedPage && Object.values(filters).some(value => value && value !== 'newest' && value !== '1')) { %><a href="/listings" class="text-link">Clear filters</a><% } %></div></div>
  <% if (!listings.length) { %><section class="empty-state"><span class="empty-icon"><%- include('partials/icon', { name: savedPage ? 'heart' : 'search', size: 36 }) %></span><h2><%= savedPage ? 'Your next favorite is out there' : 'No exact matches' %></h2><p><%= savedPage ? 'Tap the heart on a home to save it here. Your next getaway starts with a little inspiration.' : 'Try a different destination, change your dates, or adjust your filters to see more places.' %></p><a class="button button-dark" href="/listings"><%= savedPage ? 'Explore homes' : 'Explore all stays' %></a></section>
  <% } else { %><section class="listing-grid" aria-label="Properties"><% listings.forEach(listing => { %><%- include('partials/card', { listing, rating: ratings[String(listing._id)] }) %><% }) %></section><% } %>
  <% if (pages > 1) { %><nav class="pagination" aria-label="Results pages"><% if (page > 1) { %><a class="icon-button" href="<%= paginationUrl(page - 1) %>" aria-label="Previous page"><%- include('partials/icon', { name: 'left', size: 18 }) %></a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a class="icon-button" href="<%= paginationUrl(page + 1) %>" aria-label="Next page"><%- include('partials/icon', { name: 'right', size: 18 }) %></a><% } %></nav><% } %>
  <% if (!savedPage && listings.length) { %><section class="explore-more"><h2>Somewhere new is calling.</h2><p>From city weekends to quieter escapes, find your kind of stay.</p><a href="/listings?sort=price-asc" class="button button-outline">Explore affordable stays<%- include('partials/icon', { name: 'arrow', size: 18 }) %></a></section><% } %>
</main><%- include('partials/footer') %></body></html>
