<% const titles = { signup: 'Sign up', login: 'Log in', forgot: 'Reset your password', reset: 'Choose a new password', account: 'Personal info' }; const isAccount = mode === 'account'; %>
<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: titles[mode] }) %><body class="<%= isAccount ? 'account-page' : 'auth-page' %>"><%- include('partials/navbar') %>
<main id="main-content" class="<%= isAccount ? 'account-shell page-shell' : 'auth-shell' %>">
<% if (isAccount) { %><header class="page-heading"><div><a href="/listings" class="back-link">Account</a><h1>Personal info</h1><p>Manage your details and keep your account secure.</p></div><span class="avatar avatar-xl"><%= currentUser.name.charAt(0).toUpperCase() %></span></header><%- include('partials/notice') %><div class="account-layout"><aside class="account-sidebar"><a href="#profile" class="active"><%- include('partials/icon', { name: 'user', size: 20 }) %>Personal info</a><a href="#security"><%- include('partials/icon', { name: 'shield', size: 20 }) %>Login & security</a><a href="/trips"><%- include('partials/icon', { name: 'luggage', size: 20 }) %>Your trips</a><a href="/host"><%- include('partials/icon', { name: 'home', size: 20 }) %>Hosting</a></aside><div class="account-content"><section class="settings-panel" id="profile"><div class="section-heading"><h2>Your personal details</h2><%- include('partials/icon', { name: 'user', size: 24 }) %></div><p class="muted">This is how your name appears to hosts and guests.</p>
<% } else { %><section class="auth-card"><header class="auth-card-header"><a class="icon-button" href="/listings" aria-label="Back to homes"><%- include('partials/icon', { name: 'left', size: 19 }) %></a><h1><%= titles[mode] %></h1></header><div class="auth-card-content"><h2><%= mode === 'signup' || mode === 'login' ? 'Welcome to Airbnb' : mode === 'forgot' ? 'Let’s get you back in' : 'A fresh start for your account' %></h2><p class="muted"><%= mode === 'signup' ? 'Create an account to discover your next favorite place.' : mode === 'login' ? 'Your next trip starts here.' : mode === 'forgot' ? 'Enter the email address linked to your account. We’ll send you a reset link.' : 'Choose a strong, unique password to keep your account safe.' %></p><% } %>
<%- include('partials/errors', { errors }) %>
<form class="listing-form auth-form" method="POST" action="<%= mode === 'signup' ? '/signup' : mode === 'login' ? '/login' : mode === 'forgot' ? '/forgot-password' : mode === 'reset' ? '/reset-password/' + encodeURIComponent(values.token) : '/account' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (mode === 'signup' || isAccount) { %><div class="form-field"><label for="name">Your name</label><input id="name" name="name" value="<%= values.name || '' %>" required maxlength="80" autocomplete="name" placeholder="First and last name"></div><% } %>
  <% if (['signup','login','forgot','account'].includes(mode)) { %><div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" value="<%= values.email || '' %>" required maxlength="254" autocomplete="email" placeholder="you@example.com" <%= isAccount ? 'readonly' : '' %>><% if (isAccount) { %><small>Your email is used to sign in and recover your account.</small><% } %></div><% } %>
  <% if (['signup','login','reset'].includes(mode)) { %><div class="form-field"><label for="password">Password</label><div class="password-field"><input type="password" id="password" name="password" required <%= mode !== 'login' ? 'minlength=12' : '' %> maxlength="128" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>"><button type="button" class="icon-button js-only" data-toggle-password="password" aria-label="Show password"><%- include('partials/icon', { name: 'eye', size: 19 }) %></button></div><% if (mode !== 'login') { %><small>Use 12–128 characters. A unique passphrase works well.</small><% } %></div><% } %>
  <% if (['signup','reset'].includes(mode)) { %><div class="form-field"><label for="confirmPassword">Confirm password</label><div class="password-field"><input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password"><button type="button" class="icon-button js-only" data-toggle-password="confirmPassword" aria-label="Show confirmed password"><%- include('partials/icon', { name: 'eye', size: 19 }) %></button></div></div><% } %>
  <% if (mode === 'login') { %><a href="/forgot-password" class="text-link forgot-link">Forgot password?</a><% } %>
  <button class="button button-primary <%= !isAccount ? 'full-width' : '' %>"><%= mode === 'signup' ? 'Create account' : mode === 'login' ? 'Log in' : mode === 'forgot' ? 'Send reset link' : mode === 'reset' ? 'Save new password' : 'Save profile' %><%- include('partials/icon', { name: 'arrow', size: 18 }) %></button>
</form>
<% if (isAccount) { %></section><section class="settings-panel" id="security"><div class="section-heading"><h2>Login & security</h2><%- include('partials/icon', { name: 'shield', size: 24 }) %></div><p class="muted">Changing your password signs you out on every device.</p><form class="listing-form" method="POST" action="/account/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label for="currentPassword">Current password</label><input id="currentPassword" name="currentPassword" type="password" required maxlength="128" autocomplete="current-password"></div><div class="form-row"><div class="form-field"><label for="newPassword">New password</label><input id="newPassword" name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password"></div><div class="form-field"><label for="confirmNewPassword">Confirm new password</label><input id="confirmNewPassword" name="confirmPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password"></div></div><button class="button button-dark">Change password</button></form></section></div></div>
<% } else { %><div class="auth-divider"><span>Make yourself at home</span></div><p class="auth-alternative"><% if (mode === 'login') { %>Don’t have an account? <a href="/signup">Sign up</a><% } else if (mode === 'signup') { %>Already have an account? <a href="/login">Log in</a><% } else { %><a href="/login">Back to login</a><% } %></p><p class="auth-security"><%- include('partials/icon', { name: 'lock', size: 14 }) %>Your information stays protected.</p></div></section><% } %>
</main><%- include('partials/footer') %></body></html>
