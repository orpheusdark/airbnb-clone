<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: mode === 'delete' ? 'Delete account' : 'Verify email' }) %><body><%- include('partials/navbar') %><main class="auth-shell" id="main-content"><section class="auth-card"><div class="auth-card-content"><a class="back-link" href="/account">Back to account</a>
<% if (mode === 'delete') { %>
<h1>Delete your Stays account</h1><p>Your profile and reviews will be removed, your properties will be archived, and you will be signed out on every device.</p><p>Reservation and payment records are retained with a closed account reference. This action cannot be undone. Upcoming or active stays and pending refunds must be resolved first.</p>
<form method="POST" action="/account/delete" class="listing-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label for="closure-password">Current password</label><input id="closure-password" name="password" type="password" autocomplete="current-password" required maxlength="128"></div><div class="form-field"><label for="closure-confirmation">Type DELETE to confirm</label><input id="closure-confirmation" name="confirmation" required pattern="DELETE" autocomplete="off"></div><button class="button button-primary full-width">Delete my account</button></form>
<% } else { %>
<h1>Verify your email address</h1><p>Confirm that <strong><%= currentUser.email %></strong> belongs to you. This link expires after 30 minutes and can be used once.</p><form method="POST" action="/account/verify/<%= token %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary full-width">Confirm email address</button></form>
<% } %></div></section></main><%- include('partials/footer') %></body></html>
