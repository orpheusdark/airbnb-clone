<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: id ? 'Edit property' : 'Airbnb your home' }) %><body class="editor-page"><%- include('partials/navbar') %><main class="editor-shell page-shell" id="main-content"><a class="back-link" href="<%= id ? '/listings/' + id : '/host' %>"><%- include('partials/icon', { name: 'left', size: 17 }) %><%= id ? 'Back to your property' : 'Host dashboard' %></a><header class="page-heading"><div><p class="eyebrow"><%= id ? 'MAKE IT YOUR OWN' : 'BECOME A HOST' %></p><h1><%= id ? 'A little refresh for your place.' : 'Your place. Their next great stay.' %></h1><p><%= id ? 'Keep your property details fresh and welcoming.' : 'Tell guests what makes your place special.' %></p></div></header><div class="editor-layout"><aside class="editor-sidebar"><a href="#about-place" class="active"><span>01</span>About your place</a><a href="#place-details"><span>02</span>The essentials</a><a href="#place-photos"><span>03</span>Photos</a><a href="#place-amenities"><span>04</span>Amenities</a></aside><div class="editor-content"><%- include('partials/errors', { errors }) %>
<form id="property-form" class="listing-form property-form" action="<%= id ? '/listings/' + id + '/edit' : '/listings' %>" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<section id="about-place" class="editor-section"><div class="editor-section-heading"><span class="step-number">01</span><div><h2>Let’s start with the basics</h2><p>A great name and a thoughtful description go a long way.</p></div></div><div class="form-field"><label for="title">Property name</label><input id="title" name="title" value="<%= values.title || '' %>" maxlength="100" placeholder="A cozy cabin with a mountain view" required data-count-input><small class="field-count"><span data-count-for="title"><%= (values.title || '').length %></span>/100</small></div><div class="form-field"><label for="description">Description</label><textarea id="description" name="description" rows="5" maxlength="2000" placeholder="Describe the space, the atmosphere, and what guests will love…" required data-count-input><%= values.description || '' %></textarea><small class="field-count"><span data-count-for="description"><%= (values.description || '').length %></span>/2000</small></div><div class="form-row"><div class="form-field"><label for="location">City or location</label><input id="location" name="location" value="<%= values.location || '' %>" maxlength="100" placeholder="e.g. Manali" required></div><div class="form-field"><label for="country">Country</label><input id="country" name="country" value="<%= values.country || '' %>" maxlength="100" placeholder="e.g. India" required></div></div></section>
<section id="place-details" class="editor-section"><div class="editor-section-heading"><span class="step-number">02</span><div><h2>Make room for their plans</h2><p>Help guests find the right fit.</p></div></div><div class="form-row"><div class="form-field"><label for="category">Property type</label><select id="category" name="category"><% categories.forEach(category => { %><option <%= (values.category || 'Home') === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div><div class="form-field"><label for="price">Price per night (₹)</label><input id="price" name="price" type="number" min="0" max="100000000" step="0.01" value="<%= values.price ?? '' %>" placeholder="2500" required></div></div><% [['maxGuests','Maximum guests',1,2],['bedrooms','Bedrooms',0,1],['bathrooms','Bathrooms',1,1]].forEach(([key,label,min,fallback]) => { %><div class="editor-stepper-row"><div><label for="<%= key %>"><%= label %></label><p><%= key === 'maxGuests' ? 'How many people can stay?' : key === 'bedrooms' ? 'Rooms for a good night’s sleep' : 'Spaces to freshen up' %></p></div><div class="stepper-control"><button type="button" data-step="-1" data-step-target="<%= key %>" aria-label="Decrease <%= label.toLowerCase() %>"><%- include('partials/icon', { name: 'minus', size: 16 }) %></button><input id="<%= key %>" name="<%= key %>" type="number" min="<%= min %>" max="30" required value="<%= values[key] ?? fallback %>"><button type="button" data-step="1" data-step-target="<%= key %>" aria-label="Increase <%= label.toLowerCase() %>"><%- include('partials/icon', { name: 'plus', size: 16 }) %></button></div></div><% }) %></section>
<section id="place-photos" class="editor-section"><div class="editor-section-heading"><span class="step-number">03</span><div><h2>Let your place do the talking</h2><p>A little glimpse makes a big first impression.</p></div></div><div class="photo-preview"><img src="<%= photoFor(values) %>" alt="Property photo preview" data-image-preview><span>Cover photo</span></div><div class="form-field"><label for="image">Cover image URL <span>(optional)</span></label><input id="image" name="image" type="url" value="<%= values.image?.startsWith('/images/') ? '' : values.image || '' %>" placeholder="https://example.com/your-place.jpg" maxlength="2048" data-image-url><small><%= id ? 'Leave blank to keep your current cover. You can also upload a photo below.' : 'Add a public HTTP or HTTPS photo URL, or upload a cover after publishing.' %></small></div><% if (id) { %><label class="checkbox-label"><input type="checkbox" name="removeImage" value="yes">Use the property type photo instead</label><% } %><div class="form-field"><label for="gallery">More photos <span>(optional)</span></label><textarea id="gallery" name="gallery" rows="4" maxlength="8195" placeholder="Add up to four photo URLs, one per line"><%= Array.isArray(values.gallery) ? values.gallery.join('\n') : values.gallery || '' %></textarea><small>These appear alongside your cover in the photo gallery.</small></div></section>
<section id="place-amenities" class="editor-section"><div class="editor-section-heading"><span class="step-number">04</span><div><h2>What makes a stay easy?</h2><p>Choose the amenities your guests can enjoy.</p></div></div><div class="amenity-options"><% const icons = { 'Wi-Fi':'wifi', Kitchen:'kitchen', Parking:'parking', Pool:'pool', 'Air conditioning':'air', Workspace:'desk' }; amenities.forEach(amenity => { %><label><input type="checkbox" name="amenities" value="<%= amenity %>" <%= (values.amenities || []).includes(amenity) ? 'checked' : '' %>><span><%- include('partials/icon', { name: icons[amenity] }) %><%= amenity %></span></label><% }) %></div></section><div class="editor-save-bar"><a class="text-link" href="<%= id ? '/listings/' + id : '/host' %>">Cancel</a><button class="button button-primary"><%= id ? 'Save changes' : 'Publish property' %><%- include('partials/icon', { name: 'arrow', size: 18 }) %></button></div>
</form>
<% if (id) { %><section class="editor-section upload-section"><div class="editor-section-heading"><%- include('partials/icon', { name: 'image', size: 28 }) %><div><h2>Upload a cover photo</h2><p>JPEG, PNG or WebP, up to 5 MB. Save your property edits before uploading.</p></div></div><form method="POST" enctype="multipart/form-data" action="/listings/<%= id %>/image" class="upload-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="upload-dropzone"><%- include('partials/icon', { name: 'image', size: 38 }) %><label for="photo">Choose a photo of your place</label><input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" required data-upload-preview><span data-file-name>One photo, up to 5 MB</span></div><button class="button button-dark">Upload photo</button></form></section><% } %>
</div></div></main><%- include('partials/footer') %></body></html>
