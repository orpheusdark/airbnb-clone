<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'Secure checkout' }) %><body><%- include('partials/navbar') %>
<main class="form-page"><p class="eyebrow">SECURE CHECKOUT</p><h1>Complete your reservation</h1>
<section class="checkout-summary"><h2><%= listing.title %></h2><p><%= attempt.checkIn %> → <%= attempt.checkOut %> · <%= attempt.guests %> guests</p><p>Total: <strong><%= money(attempt.totalPaise) %></strong></p><p>Razorpay test mode · No real charge</p><p>Your dates are confirmed after payment verification. If the stay becomes unavailable, the test payment is reversed.</p></section>
<button class="submit-listing-btn payment-launch" id="pay" data-key="<%= keyId %>" data-order="<%= attempt.orderId %>" data-amount="<%= attempt.totalPaise %>" data-title="<%= listing.title %>">Continue to Razorpay</button>
<p id="payment-status" role="status"></p>
<form id="payment-result" method="POST" action="/payments/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="razorpay_order_id" value="<%= attempt.orderId %>"><input type="hidden" name="razorpay_payment_id"><input type="hidden" name="razorpay_signature"><button id="verify-payment" class="secondary-btn" type="submit" hidden>Retry payment verification</button></form>
<a class="back-link" href="/listings/<%= listing._id %>">Return to property</a>
</main><%- include('partials/footer') %><script src="https://checkout.razorpay.com/v1/checkout.js" defer></script><script src="/js/payment.js" defer></script></body></html>
