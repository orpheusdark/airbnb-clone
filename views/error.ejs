<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'Something went wrong' }) %><body><%- include('partials/navbar') %><main class="error-shell" id="main-content"><div><p class="eyebrow">LET’S FIND YOUR WAY BACK</p><h1><%= statusCode === 404 ? 'This place is off the map.' : statusCode === 403 ? 'Let’s check your access.' : 'A little detour.' %></h1><p><%= message || 'We couldn’t complete your request. Please try again.' %></p><a class="button button-dark" href="/listings">Explore homes<%- include('partials/icon', { name: 'arrow', size: 18 }) %></a><p class="small muted">Need a hand? <a href="/help" class="text-link">Visit the help center</a></p></div><div class="error-number" aria-hidden="true"><%= statusCode || 500 %></div></main><%- include('partials/footer') %></body></html>
