<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'Host dashboard' }) %><body><%- include('partials/navbar') %>
<main class="listings-page"><p class="eyebrow">MAKE ROOM FOR MORE</p><div class="listings-heading"><h1>Your hosting dashboard</h1><a href="/listings/new" class="create-listing-btn">Add a property</a></div>
<h2>Your properties</h2><% if (!listings.length) { %><section class="empty-state"><p>You have no properties yet.</p><a href="/listings/new">Create your first listing</a></section><% } %>
<div class="trip-grid"><% listings.forEach(listing => { %><article class="trip-card"><h3><%= listing.title %></h3><p><%= listing.location %></p><p><%= money(Math.round(listing.price * 100)) %> / night</p><% if (listing.archived) { %><span class="status-badge">Removed</span><% } else { %><div class="listing-actions"><a href="/listings/<%= listing._id %>">View</a><a href="/listings/<%= listing._id %>/edit">Edit</a><a href="/listings/<%= listing._id %>/delete" class="delete-link">Remove</a></div><% } %></article><% }) %></div>
<h2>Guest reservations</h2><p>Showing your latest 100 reservations. Guests can cancel before check-in.</p>
<% if (!bookings.length) { %><p>No reservations yet.</p><% } %>
<div class="trip-grid"><% bookings.forEach(booking => { %><article class="trip-card"><span class="status-badge"><%= booking.status %></span><h3><%= booking.title %></h3><p>Guest: <%= booking.guest?.name || 'Guest' %></p><p><%= date(booking.checkIn) %> → <%= date(booking.checkOut) %></p><p><%= booking.guests %> guests · <%= money(booking.totalPaise) %> total</p><small>Payment: <%= booking.payment === 'test-paid' ? 'Test payment confirmed' : booking.payment === 'test-refunded' ? 'Test payment reversed' : booking.payment === 'refund-pending' ? 'Reversal pending' : 'Not collected' %></small></article><% }) %></div>
</main><%- include('partials/footer') %></body></html>
