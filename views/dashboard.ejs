<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: 'Host dashboard' }) %><body class="hosting-page"><%- include('partials/navbar') %><main class="page-shell" id="main-content"><header class="page-heading"><div><p class="eyebrow">WELCOME HOME, <%= currentUser.name.toUpperCase() %></p><h1>Your hosting dashboard</h1><p>Everything you need to welcome your next guest.</p></div><a href="/listings/new" class="button button-dark"><%- include('partials/icon', { name: 'plus', size: 18 }) %>Add a property</a></header><div class="host-stats"><div><span class="stat-icon"><%- include('partials/icon', { name: 'home' }) %></span><p>Active properties</p><strong><%= listings.filter(listing => !listing.archived).length %></strong></div><div><span class="stat-icon"><%- include('partials/icon', { name: 'luggage' }) %></span><p>Reservations</p><strong><%= bookings.length %></strong></div><div><span class="stat-icon"><%- include('partials/icon', { name: 'calendar' }) %></span><p>Upcoming stays</p><strong><%= bookings.filter(booking => booking.status === 'confirmed' && date(booking.checkOut) > today).length %></strong></div></div><section class="host-properties"><div class="section-heading"><h2>Your properties</h2><span class="muted small"><%= listings.length %> total</span></div><% if (!listings.length) { %><section class="empty-state"><span class="empty-icon"><%- include('partials/icon', { name: 'home', size: 36 }) %></span><h3>Your hosting journey starts here</h3><p>Add your first property and make room for new possibilities.</p><a href="/listings/new" class="button button-primary">Create your first listing</a></section><% } %><div class="host-property-grid"><% listings.forEach(listing => { %><article class="host-property-card"><img src="<%= photoFor(listing) %>" alt="<%= listing.title %>" loading="lazy"><div><span class="listing-status"><span class="status-dot <%= listing.archived ? 'inactive' : '' %>"></span><%= listing.archived ? 'Removed' : 'Listed' %></span><h3><%= listing.title %></h3><p><%= listing.location %>, <%= listing.country %></p><p><strong><%= money(Math.round(listing.price * 100)) %></strong> / night</p><% if (!listing.archived) { %><div class="listing-actions"><a href="/listings/<%= listing._id %>" class="button button-outline button-small">View</a><a href="/listings/<%= listing._id %>/edit" class="button button-dark button-small">Edit</a><a href="/listings/<%= listing._id %>/delete" class="text-link delete-link">Remove</a></div><% } %></div></article><% }) %></div></section><section class="host-reservations"><div class="section-heading"><h2>Guest reservations</h2><span class="muted small">Latest 100 reservations</span></div><% if (!bookings.length) { %><div class="host-empty"><%- include('partials/icon', { name: 'calendar', size: 30 }) %><h3>Your next guest is out there</h3><p>Reservations will appear here as guests discover your properties.</p></div><% } else { %><div class="table-scroll"><table class="reservation-table"><thead><tr><th>Property & guest</th><th>Dates</th><th>Guests</th><th>Status</th><th>Total</th></tr></thead><tbody><% bookings.forEach(booking => { %><tr><td><strong><%= booking.title %></strong><span><%= booking.guest?.name || 'Guest' %></span></td><td><%= date(booking.checkIn) %><span>to <%= date(booking.checkOut) %></span></td><td><%= booking.guests %></td><td><span class="status-badge status-<%= booking.status %>"><%= booking.status %></span></td><td><strong><%= money(booking.totalPaise) %></strong><span><%= booking.payment === 'test-paid' ? 'Test payment confirmed' : booking.payment === 'test-refunded' ? 'Test payment reversed' : booking.payment === 'refund-pending' ? 'Reversal pending' : 'Not collected' %></span></td></tr><% }) %></tbody></table></div><% } %></section></main><%- include('partials/footer') %></body></html>
