<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Delete property | airbnb</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('partials/navbar.ejs') %>
<main class="form-page">
  <h1>Delete this property?</h1>
  <p><strong><%= listing.title %></strong> in <%= listing.location %>, <%= listing.country %> will be permanently removed.</p>
  <p>This action cannot be undone.</p>
  <form class="listing-form" method="POST" action="/listings/<%= listing._id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="submit-listing-btn" type="submit">Yes, delete property</button>
    <a class="back-link" href="/listings/<%= listing._id %>">Cancel and keep property</a>
  </form>
</main>
</body></html>
