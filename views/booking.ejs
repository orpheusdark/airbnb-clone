<!DOCTYPE html><html lang="en"><%- include('partials/head', { title: cancelling ? 'Cancel reservation' : 'Reservation details' }) %><body><%- include('partials/navbar') %><main class="receipt-shell page-shell" id="main-content"><a href="/trips" class="back-link"><%- include('partials/icon', { name: 'left', size: 17 }) %>My trips</a><%- include('partials/notice') %><header class="page-heading"><div><p class="eyebrow"><%= booking.status === 'cancelled' ? 'RESERVATION CANCELLED' : 'YOUR NEXT CHAPTER' %></p><h1><%= cancelling ? 'A change of plans?' : booking.status === 'cancelled' ? 'This reservation was cancelled' : 'Your reservation' %></h1><p><%= cancelling ? 'Review the details before you cancel your stay.' : booking.location %></p></div><span class="status-badge status-<%= booking.status %>"><%= booking.status %></span></header><div class="receipt-layout"><section class="reservation-overview"><img class="receipt-cover" src="<%= photoFor(booking.listing || {}) %>" alt="<%= booking.title %>"><div class="receipt-content"><h2><%= booking.title %></h2><p class="muted"><%= booking.location %></p><div class="receipt-dates"><div><span>Check-in</span><strong><%= date(booking.checkIn) %></strong></div><div><span>Check-out</span><strong><%= date(booking.checkOut) %></strong></div></div><div class="receipt-info-row"><%- include('partials/icon', { name: 'guests', size: 22 }) %><span><%= booking.guests %> guest<%= booking.guests === 1 ? '' : 's' %> · <%= booking.nights %> night<%= booking.nights === 1 ? '' : 's' %></span></div><% if (!booking.listing?.archived) { %><a class="button button-outline" href="/listings/<%= booking.listing?._id || booking.listing %>">View property and reviews<%- include('partials/icon', { name: 'arrow', size: 17 }) %></a><% } else { %><p class="muted">This property is no longer publicly listed. Your reservation details remain available here.</p><% } %></div></section><aside class="receipt-sidebar"><section class="receipt-panel"><h2>Reservation details</h2><dl class="summary-list"><dt>Confirmation code</dt><dd class="reference"><%= booking._id %></dd><dt>Nightly price</dt><dd><%= money(booking.nightlyPaise) %></dd><dt class="summary-total">Total for <%= booking.nights %> nights</dt><dd class="summary-total"><%= money(booking.totalPaise) %></dd></dl><div class="payment-status"><%- include('partials/icon', { name: 'card', size: 20 }) %><div><strong>Payment</strong><p><%= booking.payment === 'test-paid' ? 'Test payment confirmed · No real charge' : booking.payment === 'test-refunded' ? 'Test payment reversed' : booking.payment === 'refund-pending' ? 'Reversal pending' : 'Not collected' %></p></div></div></section><section class="receipt-panel"><h2>Manage your trip</h2><% if (booking.status === 'confirmed' && date(booking.checkIn) > today) { %><% if (cancelling) { %><p>Cancelling releases these dates for other guests. This cannot be undone.</p><form method="POST" action="/trips/<%= booking._id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger full-width">Yes, cancel reservation</button><a href="/trips/<%= booking._id %>" class="button button-outline full-width">Keep my reservation</a></form><% } else { %><p>You can cancel before your check-in date.</p><a class="button button-outline full-width" href="/trips/<%= booking._id %>/cancel">Cancel reservation</a><% } %><% } else { %><p class="muted"><%= booking.status === 'cancelled' ? 'Ready for something new? Find another place for your next getaway.' : 'This stay has started or finished; it can no longer be cancelled.' %></p><a href="/listings" class="button button-outline full-width">Explore stays</a><% } %><a href="/help#reservations" class="text-link">Need help with this trip?</a></section></aside></div></main><%- include('partials/footer') %></body></html>
