<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create a Listing | Airbnb Clone</title>
</head>
<body>
  <h1>Add a Travel Listing</h1>

  <form action="/listings" method="POST">
    <div>
      <label for="title">Property title</label>
      <input
        type="text"
        id="title"
        name="title"
        required
      >
    </div>

    <div>
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
      ></textarea>
    </div>

    <div>
      <label for="price">Price per night (₹)</label>
      <input
        type="number"
        id="price"
        name="price"
        min="0"
        step="0.01"
        required
      >
    </div>

    <div>
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        required
      >
    </div>

    <div>
      <label for="country">Country</label>
      <input
        type="text"
        id="country"
        name="country"
        required
      >
    </div>

    <div>
      <label for="image">Image URL (optional)</label>
      <input
        type="url"
        id="image"
        name="image"
        placeholder="https://example.com/property.jpg"
      >
    </div>

    <button type="submit">Create Listing</button>
  </form>
</body>
</html>