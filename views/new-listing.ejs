<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add a Property | airbnb</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include("partials/navbar.ejs") %>

    <main class="form-page">
      <section class="form-intro">
        <p class="eyebrow">BECOME A HOST</p>
        <h1>Share your place<br />with the <span>world.</span></h1>
        <p>Add the details below to publish your property on airbnb.</p>
      </section>

      <form class="listing-form" action="/listings" method="POST">
        <div class="form-section-heading">
          <span class="step-number">01</span>
          <div>
            <h2>Property details</h2>
            <p>Tell travellers about your place.</p>
          </div>
        </div>

        <div class="form-field">
          <label for="title">Property name</label>
          <input
            type="text"
            id="title"
            name="title"
            placeholder="e.g. Cozy Studio Apartment"
            maxlength="100"
            required
          />
        </div>

        <div class="form-field">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            placeholder="What makes your property special?"
            rows="4"
            maxlength="2000"
            required
          ></textarea>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="price">Price per night (₹)</label>
            <input
              type="number"
              id="price"
              name="price"
              placeholder="2500"
              min="0"
              step="1"
              required
            />
          </div>

          <div class="form-field">
            <label for="country">Country</label>
            <input
              type="text"
              id="country"
              name="country"
              placeholder="India"
              maxlength="100"
              required
            />
          </div>
        </div>

        <div class="form-field">
          <label for="location">City or location</label>
          <input
            type="text"
            id="location"
            name="location"
            placeholder="e.g. Mumbai"
            maxlength="100"
            required
          />
        </div>

        <div class="form-field">
          <label for="image">Property image URL <span>(optional)</span></label>
          <input
            type="url"
            id="image"
            name="image"
            placeholder="https://example.com/property.jpg"
          />
          <small>Use a publicly accessible image URL.</small>
        </div>

        <button class="submit-listing-btn" type="submit">
          Publish property <span aria-hidden="true">→</span>
        </button>

        <p class="form-footnote">Check your details before publishing.</p>
      </form>
    </main>
  </body>
</html>
